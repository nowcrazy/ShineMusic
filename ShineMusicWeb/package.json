{
  "name": "shine-music-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "import:from-app": "node scripts/import-from-app.mjs",
    "gen:contracts": "python ../ShineMusicApi/tools/generate-ts-contracts.py",
    "check:contracts": "python ../ShineMusicApi/tools/generate-ts-contracts.py --check"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "5.0.4",
    "sass": "1.78.0",
    "typescript": "^5.7.2",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.0"
  }
}
