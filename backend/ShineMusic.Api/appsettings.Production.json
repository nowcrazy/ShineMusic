{
  // ============================================================
  //  #Server · 生产部署
  // ------------------------------------------------------------
  //  生效条件：ASPNETCORE_ENVIRONMENT=Production（未显式设置时的默认值）
  //  CORS 与邀请邮件链接已统一由 config/hosts.json 的 server 段推导，
  //  上线前只改 config/hosts.json，不要在这里重复配置。
  // ============================================================

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // 对外监听：0.0.0.0 允许公网/局域网访问，改端口只改这里 + 重启后端。
  // 开发环境不受影响（launchSettings 的 localhost:5143 优先级更高）。
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5180"
      }
    }
  }
}
