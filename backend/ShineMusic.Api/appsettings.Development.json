{
  // ============================================================
  //  #Local · 本地开发 / 局域网测试
  // ------------------------------------------------------------
  //  生效条件：ASPNETCORE_ENVIRONMENT=Development
  //  CORS 与邀请邮件链接已统一由 config/hosts.json 的 local 段推导，
  //  改 IP 请只改 config/hosts.json，不要在这里重复配置。
  // ============================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      // 文件日志分类：操作/登录/SQL 记 Information，调试打点记 Debug。
      "Operations": "Information",
      "Auth": "Information",
      "DataExecution": "Information",
      "Debug": "Debug"
    }
  }
}
