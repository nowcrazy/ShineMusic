# ============================================================================
# ShineMusic 后端代码分析规则
#
# 约定：本文件与 backend/Directory.Build.props 共同构成「工程闸门」。
#   - TreatWarningsAsErrors=true：所有 severity=warning/suggestion 的规则在构建时即失败。
#   - CA*（NetAnalyzers）规则默认开启并升级为错误，除「豁免清单」外不允许新增 none。
#   - IDE*（代码风格）规则只在编辑器/保存时提示，不参与构建（未开 EnforceCodeStyleInBuild）。
#
# 新增豁免必须写清理由，禁止为了让构建通过而静默关规则。
# ============================================================================

root = false

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# ---------------------------------------------------------------------------
# 命名
# ---------------------------------------------------------------------------
dotnet_naming_rule.interfaces_should_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_begin_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.style = camel_case_underscore_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

# ---------------------------------------------------------------------------
# using / 代码风格（仅编辑器提示，不升级为构建错误）
# ---------------------------------------------------------------------------
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = when_multiline:suggestion
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true:suggestion
csharp_new_line_before_open_brace = all:suggestion
csharp_indent_case_contents = true:suggestion

# ===========================================================================
# 一、EF Core 生成的迁移代码：整体豁免
#
# Data/Migrations/** 由 `dotnet ef migrations add` 生成，编辑它会与模型快照脱钩；
# 其中的 CA1861（常量数组作参数）等规则对生成代码没有意义。
# ===========================================================================
[**/Data/Migrations/**/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ===========================================================================
# 二、豁免清单（每条附理由；需要解释的是「为什么这条规则现在不适用」）
# ===========================================================================

[*.cs]

# CA1862：大小写不敏感比较应改用 string.Equals(x, y, StringComparison)。
# 不豁免则以 OrdinalIgnoreCase 替换现有 `a.Trim().ToLowerInvariant() == b`，
# 会同时改变「写入数据库的状态字面量」语义（当前统一归一化为小写后落库）。
# 状态机依赖全小写取值，暂保持归一化比较；后续改为后端 enum 时一并清理。
dotnet_diagnostic.CA1862.severity = none

# CA1848 / CA1873：日志须用 LoggerMessage 委托、参数须判 IsEnabled。
# 当前接口为低频管理端操作，日志量小，委托化收益低于其可读性成本；
# 若将来出现高频路径（如播放事件上报）再对那几处单独委托化。
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# CA1859：建议把参数/返回类型从接口改为具体类型以性能。
# 现有 IReadOnlyCollection/IReadOnlyDictionary 是刻意收窄的可变面，
# 与生成契约的 readonly 数组同向；这是有意的抽象，不是疏漏。
dotnet_diagnostic.CA1859.severity = none

# CA2007：ConfigureAwait。ASP.NET Core 无 SynchronizationContext，加/不加等价。
dotnet_diagnostic.CA2007.severity = none

# CA1707 / CA1716：标识符含下划线、与语言关键字同名。
# 本项目用下划线分隔语义段（如 lyric_formats、in_progress）属于对外契约字面量，
# 改名会改变 HTTP 接口与数据库取值。
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1716.severity = none

# CA1031：catch 通用异常。兜底中间件与存储层刻意捕获 Exception 后转 5xx 契约错误体。
dotnet_diagnostic.CA1031.severity = none

# CA1711：类型名不应以 Collection/Queue 等集合后缀结尾。
# 例外：EditorialCollection（精选合集）、LibraryImportQueue（导入等待队列）是领域词汇本身，
# 按规则改成 EditorialSet/ImportWaitingList 会让模型与产品概念脱节；EF 实体名也进入数据库表名。
dotnet_diagnostic.CA1711.severity = none

# CA1725：参数名应与基类成员一致（OnModelCreating 的 builder）。
# 例外：MusicDbContext.OnModelCreating 的方法体内约 50 处配置语句均按 EF Core 官方文档惯例
# 使用 modelBuilder；为一个命名规则改写全部配置代码没有收益，且降低与社区示例的可对照性。
dotnet_diagnostic.CA1725.severity = none

# CA1861（非迁移代码中的常量数组参数）：属微优化，保留可读性优先。
dotnet_diagnostic.CA1861.severity = none

# CA1305 / CA1307：指定 IFormatProvider / ToLower(CultureInfo)。
# 服务端 InvariantGlobalization=true，且字符串比较/归一化路径均已显式用 Ordinal 系 API；
# 未显式指定的均为展示用途（错误消息拼接），不受全球化影响。
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none

# ===========================================================================
# 三、契约相关硬规则：这些是本次审计后新增的「前后端约束」落点
# ===========================================================================

# CA1062：校验公共方法的 null 参数。控制器入参由模型绑定保证，无需在每个 action 重复判空。
dotnet_diagnostic.CA1062.severity = none

# CA1515：控制台程序才要求 Main；本项对 Web SDK 无意义。
dotnet_diagnostic.CA1515.severity = none
