<Project>

  <!--
    工程级约束：一次配置，ShineMusic.Api 项目生效。

    - TreatWarningsAsErrors：把「编译器警告」与「NetAnalyzers (CAxxxx) 警告」升级为错误，
      防止带病代码合入。新增告警必须先在这里显式豁免并写理由，不允许就地注释掩盖。
    - AnalysisLevel=latest-recommended：启用微软推荐子集（CA1062/CA1305/CA2007 等），
      不用 latest-all（会引入大量风格类噪音，收益低）。
    - 不开启 EnforceCodeStyleInBuild：代码风格由 .editorconfig 在开发期/保存时约束，
      避免把 IDE00xx 风格规则变成构建错误。
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 公开 API（Controllers/Endpoints 的入参出参）缺失 XML 注释视为契约缺漏 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
