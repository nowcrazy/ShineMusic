{
  // 环境相关配置已拆分（改 IP 只动对应文件，互不影响）：
  //   appsettings.Development.json  → #Local   本地开发 / 局域网测试
  //   appsettings.Production.json   → #Server  生产部署
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // 以下为文件日志的自定义分类，显式固定级别，避免被 Default 过滤：
      "Operations": "Information",
      "Auth": "Information",
      "DataExecution": "Information",
      "Debug": "Debug"
    }
  },
  "Database": {
    // PostgreSQL（docker compose 的 postgres 服务）；连接串（含口令）由 Database__ConnectionString 注入。
    "ConnectionString": "Host=localhost;Port=5432;Database=shinemusic;Username=shinemusic"
  },
  "Redis": {
    // docker compose 的 redis 服务；连接串（含口令）由 Redis__ConnectionString 注入；留空则回退内存缓存。
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    // docker compose 的 rabbitmq 服务；口令由 RabbitMQ__Password 注入。
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "shinemusic",
    "Password": ""
  },
  "Storage": {
    "LibraryRoot": "../../data/library",
    "QuarantineRoot": "../../data/quarantine"
  },
  "Auth": {
    "Issuer": "ShineMusic",
    "Audience": "ShineMusic.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "InvitationExpiryHours": 48
  },
  "PasswordPolicy": {
    "MinimumStrength": 2
  },
  "InvitationEmail": {
    // 敏感信息不入库：SMTP 授权码通过用户机密（dotnet user-secrets）或环境变量
    // InvitationEmail__Password 注入，仓库里保持为空。
    "FromAddress": "965610942@qq.com",
    "SmtpHost": "smtp.qq.com",
    "SmtpPort": 465,
    "Username": "965610942@qq.com",
    "Password": "",
    "UseSsl": true
  },
  "Features": {
    "AnonymousPlayback": true,
    "UserCollections": true,
    "SongRequests": true,
    "AdminLibraryImport": true,
    "UserUploads": true,
    "ManualReview": true,
    "EditorialCollections": true,
    "ListeningEvents": true,
    "PersonalizedRecommendations": true,
    "ServerTranscoding": true,
    "SourceDownload": true
  },
  "SongRequestFulfillment": {
    "Checks": {
      "TitleArtistMatch": { "Mode": "Enforced", "AllowAdminOverride": false },
      "DuplicateInLibrary": { "Mode": "Enforced", "AllowAdminOverride": true },
      "CopyrightCheck": { "Mode": "Warning", "AllowAdminOverride": true },
      "MetadataAutoMatch": { "Mode": "Warning", "AllowAdminOverride": true },
      "AudioFormat": { "Mode": "Enforced", "AllowAdminOverride": false },
      "LyricsPresent": { "Mode": "Disabled", "AllowAdminOverride": true }
    },
    "TitleArtistMatch": {
      "MaxEditDistance": 1,
      "Normalize": true
    },
    "AdminBypassRequiresReason": true
  },
  "SongRequests": {
    "ArchiveEnabled": true,
    "ArchiveAfterDays": 30,
    "ArchiveScanIntervalMinutes": 60
  },
  "Uploads": {
    "MaxFileSizeBytes": 262144000,
    "MaxBatchSizeBytes": 1073741824,
    "MaxFilesPerBatch": 10,
    "AllowedFormats": [
      "mp3", "flac", "wav", "aac", "m4a", "m4b", "ogg", "oga",
      "wma", "aiff", "aif", "ape", "mpc", "mpp", "wv", "dsf"
    ]
  },
  "Transcoding": {
    // 2026-11-12：转码产物现在只是「兼容副本」（不支持 FLAC 等容器的客户端回落用）。
    // 发布时由 PlaybackMediaPolicy 决定主资产：原文件更好且可流时，播放器直接输出 320k/无损原文件。
    // 因此这里保持 192kbps 不会再把高质量曲目降质播放；也不要把它调高（有损转码无音质收益，只增体积）。
    "TargetFormat": "aac_m4a",
    "BitrateKbps": 192,
    "MaxConcurrentJobs": 1
  },
  "LibraryImport": {
    // 管理员手动导入：转码后自动评分，达标（≥阈值）直通发布，未达标转人工审核
    "AutoPublishEnabled": true,
    "AutoPublishThreshold": 75
  },
  "MediaLease": {
    // Worker 每 15 秒续租；停止续租后最多约 120 秒允许接管，恢复扫描间隔 15 秒。
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 15,
    "RecoveryBatchSize": 100
  },
  "Ffmpeg": {
    "ExecutablePath": "ffmpeg",
    "ProbeExecutablePath": "ffprobe",
    "TimeoutMinutes": 30
  },
  "Lyrics": {
    "AutoFetchEnabled": true,
    "Provider": "lrclib",
    // 外部歌词源链（按序兜底）：lrclib 开源多语言源优先，中文源 kugou/migu 依次兜底；网易云/QQ 因风控未启用
    "ExternalSources": [ "lrclib", "kugou", "migu" ],
    "BaseUrl": "https://lrclib.net/api",
    "TimeoutSeconds": 6,
    "DurationToleranceSeconds": 5,
    "MinScore": 0.6,
    "PreferSynced": true,
    "ConvertTraditionalToSimplified": false,
    "UserAgent": "ShineMusic/1.0"
  },
  "SourceDownload": {
    // 2026-11-16逐源实测：元数据、搜索、下载按能力分别启用。
    // 证据与范围见 docs/provider-verification.json；平台匿名态，不保证所有歌曲。
    // Audius/Jamendo只证明自身曲库能力；中文歌曲须继续严格匹配身份。
    "Audius": { "Enabled": true, "BaseUrl": "https://api.audius.co", "AppName": "ShineMusic" },
    // Jamendo：client_id 来自 devportal.jamendo.com；生产可用环境变量 SourceDownload__Jamendo__ClientId 覆盖
    "Jamendo": { "Enabled": true, "BaseUrl": "https://api.jamendo.com/v3.0", "ClientId": "65e6be25" },
    // 酷我：搜索与详情三曲验证通过，下载三曲受限。
    "Kuwo": { "Enabled": true, "Cookie": "" },
    // 酷狗：Android搜索指纹恢复结果，详情可用；低码率/权限受限，不启用下载。
    "Kugou": { "Enabled": true, "Cookie": "" },
    // 网易：已知ID富士山下可得完整FLAC，晴天受限；搜索原唱命中差，保持质量校验与换源。
    "Netease": { "Enabled": true, "Bitrate": 320000, "Cookie": "", "VipFallback": { "Enabled": true, "TimeoutSeconds": 15, "Endpoints": [ { "Type": "gdstudio", "Url": "https://music-api.gdstudio.xyz/api.php?types=url&source=netease&id={id}&br={level}", "Levels": ["320", "999"] } ] } },
    // 咪咕：晴天与富士山下实测FLAC，月亮代表我的心失败，按曲目可用性处理。
    "Migu": { "Enabled": true, "ToneFlag": "HQ", "Cookie": "" },
    // 汽水：当前搜索HTTP200空体；详情与完整下载未独立验证，保持关闭。
    "Qishui": { "Enabled": false, "Cookie": "" },
    // QQ：兼容新版详情字段后三曲通过；匿名vkey受限，不启用下载。
    "Qq": { "Enabled": true, "Cookie": "" },
    // 千千：自身候选可搜索/取详情，三曲原唱未命中，下载未验证达标。
    "Qianqian": { "Enabled": true },
    // Bilibili：搜索/视频详情可用，yt-dlp下载HTTP412；仅启用信息能力。
    "Bilibili": { "Enabled": true },
    // YouTube：搜索可达但详情超时，提取WAV不代表上游无损，保持自动链关闭。
    "YtDlp": { "Enabled": false, "ExecutablePath": "../tools/yt-dlp.exe", "CookiesFile": "../tools/youtube-cookies.txt", "Proxy": "", "SearchTimeoutSeconds": 120, "MetadataTimeoutSeconds": 30 },
    "Download": { "TimeoutSeconds": 120, "MaxFileSizeBytes": 262144000, "MaxConcurrentDownloads": 2 },
    // ── V2.0 Phase 1：Provider 核心架构（加法式配置，不改上面任何既有键）──────────
    // 总预算与单源预算分离；Priority 只决定调度顺序，不代表音质等级。
    // 元数据、搜索、下载分别启用；平台原有 Enabled 仍是总闸门。
    // QualityGate 在下载后验证真实质量；Provider 健康状态独立于配置。
    "ProviderFramework": {
      "Enabled": true,
      "Search": {
        "TotalBudgetSeconds": 25,
        "ProviderTimeoutSeconds": 8,
        "MaxProviderTimeoutSeconds": 12,
        "MaxConcurrentProviders": 5,
        "MaxResultsPerProvider": 20
      },
      "HealthCheck": { "Enabled": true, "IntervalMinutes": 30, "FailureThreshold": 5, "RecoverySeconds": 60, "MaxRecoverySeconds": 300 },
      "QualityPolicy": {
        "PreferredQuality": "320K",
        "MinimumQuality": "192K",
        "AllowLossyFallback": true,
        "AllowPreview": false,
        "RequireFullTrack": true,
        "RequireStudioVersion": true,
        "MinimumMatchScore": 90,
        "MinimumMetadataScore": 75
      },
      "Providers": {
        "netease": { "Enabled": true, "Priority": 95, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": true },
        "migu": { "Enabled": true, "Priority": 100, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": true },
        "kuwo": { "Enabled": true, "Priority": 80, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": false },
        "qq": { "Enabled": true, "Priority": 75, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": false },
        "kugou": { "Enabled": true, "Priority": 70, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": false },
        "qianqian": { "Enabled": true, "Priority": 65, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": false },
        "qishui": { "Enabled": false, "Priority": 60, "MetadataEnabled": false, "SearchEnabled": false, "DownloadEnabled": false },
        "audius": { "Enabled": true, "Priority": 40, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": true },
        "jamendo": { "Enabled": true, "Priority": 35, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": true },
        "bilibili": { "Enabled": true, "Priority": 20, "MetadataEnabled": true, "SearchEnabled": true, "DownloadEnabled": false },
        "ytmusic": { "Enabled": false, "Priority": 10, "MetadataEnabled": false, "SearchEnabled": false, "DownloadEnabled": false }
      }
    },
    // 聚合搜索单源预算（秒）：任一源超时即跳过该源并标注 providerErrors，其余源结果照常返回（防止不可达源拖垮整体）
    "SearchBudgetSeconds": 25,
    // 音源自动发布：身份与版本确认、原音频质量合格、完整可播且发布校验通过。
    // 分项评分用于展示，不再用总分决定音源发布资格。
    // AutoPublishThreshold 保留兼容配置读取；管理员手动导入使用 LibraryImport 自身策略。
    "AutoPublishEnabled": true,
    "AutoPublishThreshold": 90,
    // 四个评分维度逐项独立配置、合计必须 100（用户 2026-11-12 裁决）。
    // 数值调整须单独评审；改这里不需要改代码，评分器按各项满分等比缩放内部分项。
    "ScoreWeights": {
      "Identity": 40,
      "Quality": 40,
      "Metadata": 15,
      "Lyrics": 5
    }
  },
  // 后台任务分组（P5）：all=单体全跑；web=Web 进程只跑非媒体任务，媒体任务交给 ShineMusic.Worker；
  // media=只跑媒体任务；none=不跑后台任务。也可用环境变量 Worker__Mode 覆盖。
  "Worker": { "Mode": "all" },
  "AllowedHosts": "*"
}
