{
  // 环境相关配置已拆分（改 IP 只动对应文件，互不影响）：
  //   appsettings.Development.json  → #Local   本地开发 / 局域网测试
  //   appsettings.Production.json   → #Server  生产部署
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // 以下为文件日志的自定义分类，显式固定级别，避免被 Default 过滤：
      "Operations": "Information",
      "Auth": "Information",
      "DataExecution": "Information",
      "Debug": "Debug"
    }
  },
  "Database": {
    // PostgreSQL（docker compose 的 postgres 服务）；生产用环境变量 Database__ConnectionString 覆盖口令。
    "ConnectionString": "Host=localhost;Port=5432;Database=shinemusic;Username=shinemusic;Password=shinemusic-dev"
  },
  "Redis": {
    // docker compose 的 redis 服务；留空则回退进程内内存缓存（仅限无 Docker 的临时开发场景）。
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    // docker compose 的 rabbitmq 服务；生产用环境变量 RabbitMQ__Password 覆盖口令。
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "shinemusic",
    "Password": "shinemusic-dev"
  },
  "Storage": {
    "LibraryRoot": "../../data/library",
    "QuarantineRoot": "../../data/quarantine"
  },
  "Auth": {
    "Issuer": "ShineMusic",
    "Audience": "ShineMusic.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "InvitationExpiryHours": 48
  },
  "PasswordPolicy": {
    "MinimumStrength": 2
  },
  "InvitationEmail": {
    // 敏感信息不入库：SMTP 授权码通过用户机密（dotnet user-secrets）或环境变量
    // InvitationEmail__Password 注入，仓库里保持为空。
    "FromAddress": "965610942@qq.com",
    "SmtpHost": "smtp.qq.com",
    "SmtpPort": 465,
    "Username": "965610942@qq.com",
    "Password": "",
    "UseSsl": true
  },
  "Features": {
    "AnonymousPlayback": true,
    "UserCollections": true,
    "SongRequests": true,
    "AdminLibraryImport": true,
    "UserUploads": true,
    "ManualReview": true,
    "EditorialCollections": true,
    "ListeningEvents": true,
    "PersonalizedRecommendations": true,
    "ServerTranscoding": true,
    "SourceDownload": true
  },
  "SongRequestFulfillment": {
    "Checks": {
      "TitleArtistMatch": { "Mode": "Enforced", "AllowAdminOverride": false },
      "DuplicateInLibrary": { "Mode": "Enforced", "AllowAdminOverride": true },
      "CopyrightCheck": { "Mode": "Warning", "AllowAdminOverride": true },
      "MetadataAutoMatch": { "Mode": "Warning", "AllowAdminOverride": true },
      "AudioFormat": { "Mode": "Enforced", "AllowAdminOverride": false },
      "LyricsPresent": { "Mode": "Disabled", "AllowAdminOverride": true }
    },
    "TitleArtistMatch": {
      "MaxEditDistance": 1,
      "Normalize": true
    },
    "AdminBypassRequiresReason": true
  },
  "SongRequests": {
    "ArchiveEnabled": true,
    "ArchiveAfterDays": 30,
    "ArchiveScanIntervalMinutes": 60
  },
  "Uploads": {
    "MaxFileSizeBytes": 262144000,
    "MaxBatchSizeBytes": 1073741824,
    "MaxFilesPerBatch": 10,
    "AllowedFormats": [
      "mp3", "flac", "wav", "aac", "m4a", "m4b", "ogg", "oga",
      "wma", "aiff", "aif", "ape", "mpc", "mpp", "wv", "dsf"
    ]
  },
  "Transcoding": {
    "TargetFormat": "aac_m4a",
    "BitrateKbps": 192,
    "MaxConcurrentJobs": 1
  },
  "LibraryImport": {
    // 管理员手动导入：转码后自动评分，达标（≥阈值）直通发布，未达标转人工审核
    "AutoPublishEnabled": true,
    "AutoPublishThreshold": 70
  },
  "Ffmpeg": {
    "ExecutablePath": "ffmpeg",
    "ProbeExecutablePath": "ffprobe",
    "TimeoutMinutes": 30
  },
  "Lyrics": {
    "AutoFetchEnabled": true,
    "Provider": "lrclib",
    // 外部歌词源链（按序兜底）：lrclib 开源多语言源优先，中文源 kugou/migu 依次兜底；网易云/QQ 因风控未启用
    "ExternalSources": [ "lrclib", "kugou", "migu" ],
    "BaseUrl": "https://lrclib.net/api",
    "TimeoutSeconds": 6,
    "DurationToleranceSeconds": 5,
    "MinScore": 0.6,
    "PreferSynced": true,
    "ConvertTraditionalToSimplified": false,
    "UserAgent": "ShineMusic/1.0"
  },
  "SourceDownload": {
    // Audius：开放版权平台，免密钥（仅需 app_name 标识）
    "Audius": { "Enabled": true, "BaseUrl": "https://api.audius.co", "AppName": "ShineMusic" },
    // Jamendo：client_id 来自 devportal.jamendo.com（免费注册）；生产可用环境变量 SourceDownload__Jamendo__ClientId 覆盖
    "Jamendo": { "Enabled": true, "BaseUrl": "https://api.jamendo.com/v3.0", "ClientId": "65e6be25" },
    // 酷我：免密钥 HTTP 直链音源（128k mp3，覆盖非独家中文曲库；VIP 独家曲会判定不可下载）
    "Kuwo": { "Enabled": true },
    // yt-dlp 桥接（YouTube Music / SoundCloud）：内嵌子进程模式，主服务启动即具备音源能力；
    // ExecutablePath 相对内容根目录解析，缺省 ../tools/yt-dlp.exe（= 仓库 ShineMusicApi/tools/yt-dlp.exe）；
    // YouTube 触发风控 403/登录校验时，把浏览器导出的 cookies.txt 路径填入 CookiesFile。
    // Proxy：国内网络访问 YouTube/SoundCloud 需配置（如 http://127.0.0.1:7890）；留空为直连。
    "YtDlp": { "Enabled": true, "ExecutablePath": "../tools/yt-dlp.exe", "CookiesFile": "../tools/youtube-cookies.txt", "Proxy": "", "SearchTimeoutSeconds": 120, "MetadataTimeoutSeconds": 30 },
    "Download": { "TimeoutSeconds": 120, "MaxFileSizeBytes": 262144000, "MaxConcurrentDownloads": 1 },
    // 聚合搜索单源预算（秒）：任一源超时即跳过该源并标注 providerErrors，其余源结果照常返回（防止不可达源拖垮整体）
    "SearchBudgetSeconds": 25,
    // 评分闸门：音源条目转码后自动评分（音质50+元数据30+歌词20），≥阈值直通入库，否则转人工审核
    "AutoPublishEnabled": true,
    "AutoPublishThreshold": 70
  },
  "AllowedHosts": "*"
}
